<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AndroidStructure" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">@color/theme_color</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="popupMenuBackground">@color/white</item>
    </style>

    <style name="Theme.AndroidStructure" parent="Base.Theme.AndroidStructure" />

    <style name="DialogTheme" parent="@android:style/Theme.Dialog">
        <item name="android:paddingHorizontal">15dp</item>
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowIsFloating">false</item> <!--For use full with than use false-->
    </style>

</resources>